{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pstack.dynamic-task.v1",
  "type": "object",
  "required": [
    "schema",
    "task_id",
    "route_target",
    "revision",
    "workflow_id",
    "method",
    "provider",
    "model",
    "status",
    "summary",
    "evidence",
    "findings"
  ],
  "properties": {
    "schema": {
      "const": "pstack.dynamic-task.v1"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "route_target": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{40,64}$"
    },
    "workflow_id": {
      "type": "string",
      "minLength": 1
    },
    "method": {
      "enum": [
        "swarm",
        "arena",
        "interrogate"
      ]
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "complete",
        "blocked"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "findings": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "required": [
          "claim"
        ],
        "properties": {
          "claim": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "additionalProperties": false
}
