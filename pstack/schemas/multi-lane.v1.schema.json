{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pstack.multi-lane.v1",
  "title": "PStack bounded multi-model lane evidence",
  "type": "object",
  "required": [
    "schema",
    "workflow",
    "workflow_id",
    "lane_id",
    "run_target",
    "provider",
    "model",
    "source_revision",
    "status",
    "summary",
    "evidence",
    "findings"
  ],
  "properties": {
    "schema": {
      "const": "pstack.multi-lane.v1"
    },
    "workflow": {
      "enum": [
        "swarm",
        "arena",
        "interrogate"
      ]
    },
    "workflow_id": {
      "type": "string",
      "minLength": 1
    },
    "lane_id": {
      "enum": [
        "a",
        "b",
        "c"
      ]
    },
    "run_target": {
      "enum": [
        "pstack.panel-a",
        "pstack.panel-b",
        "pstack.panel-c"
      ]
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "source_revision": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "complete",
        "blocked"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "claim",
          "evidence_refs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  },
  "additionalProperties": true
}
