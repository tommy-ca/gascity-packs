{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gascity-pack:graph-engineering:reference:v0",
  "title": "Non-authoritative graph engineering semantic reference (NOT host runtime contract)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "authority",
    "goal_ref",
    "graph",
    "evidence_class"
  ],
  "properties": {
    "schema_version": {
      "const": "gc.graph-semantic-reference/v0"
    },
    "authority": {
      "const": "REFERENCE_ONLY"
    },
    "goal_ref": {
      "type": "string",
      "minLength": 1
    },
    "evidence_class": {
      "enum": [
        "ILLUSTRATIVE",
        "STATIC_SOURCE",
        "UNVERIFIED"
      ]
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodes"
      ],
      "properties": {
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "role",
              "needs",
              "writer",
              "acceptance_ref"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[a-z][a-z0-9-]{0,79}$"
              },
              "role": {
                "type": "string",
                "minLength": 1
              },
              "needs": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "writer": {
                "type": "string",
                "minLength": 1
              },
              "acceptance_ref": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
